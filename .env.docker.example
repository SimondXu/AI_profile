# Docker environment file template
# Copy to .env.docker and fill in the real values on the server
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
# Comma-separated OpenRouter provider slugs to pin to, in priority order (empty = no pinning)
OPENROUTER_PROVIDER_ORDER=fireworks
# Cap on tokens generated per chat reply (positive int, default 1024)
OPENROUTER_MAX_OUTPUT_TOKENS=1024
# Global /api/chat budget across all visitors; over budget serves the local fallback
CHAT_GLOBAL_MAX_PER_HOUR=300
CHAT_GLOBAL_MAX_PER_DAY=1500
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Private tracking (do not use these placeholder values in production)
TRACKING_ENABLED=true
TRACKING_DB_PATH=/app/data/tracking.db
# Set true only after Baota/Nginx is configured to overwrite X-Forwarded-For/X-Real-IP.
TRACKING_TRUST_PROXY=false
TRACKING_RETENTION_DAYS=90
TRACKING_PASSWORD_HASH=replace_with_scrypt_salt_and_hash
TRACKING_ENCRYPTION_KEY=replace_with_32_byte_base64_key
TRACKING_IP_HASH_KEY=replace_with_long_random_secret
TRACKING_SESSION_SECRET=replace_with_long_random_secret
IPINFO_LITE_TOKEN=
