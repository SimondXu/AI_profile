# Required for AI chat functionality (OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional - default: deepseek/deepseek-v4.1-flash
# OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
# Optional - comma-separated OpenRouter provider slugs to pin to, in priority order
# (default: fireworks; set to an empty value to let OpenRouter route freely)
# OPENROUTER_PROVIDER_ORDER=fireworks
# Optional - cap on tokens generated per chat reply (positive int, default 1024)
# OPENROUTER_MAX_OUTPUT_TOKENS=1024
# Optional - global /api/chat budget across all visitors; over budget serves the local fallback
# CHAT_GLOBAL_MAX_PER_HOUR=300
# CHAT_GLOBAL_MAX_PER_DAY=1500

# Optional - for custom domain
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional - for analytics (if you add them)
# NEXT_PUBLIC_GA_ID=your_google_analytics_id

# Private visitor tracking. Generate secrets offline; never commit real values.
TRACKING_ENABLED=true
TRACKING_DB_PATH=./data/tracking.db
# Required in production: set true only when Baota/Nginx overwrites forwarding headers.
TRACKING_TRUST_PROXY=false
TRACKING_RETENTION_DAYS=90
# format: base64_salt:base64_scrypt_hash (derive with Node's built-in scrypt)
TRACKING_PASSWORD_HASH=replace_with_scrypt_salt_and_hash
# 32 random bytes encoded as base64
TRACKING_ENCRYPTION_KEY=replace_with_32_byte_base64_key
# Long random secrets (at least 32 characters)
TRACKING_IP_HASH_KEY=replace_with_long_random_secret
TRACKING_SESSION_SECRET=replace_with_long_random_secret
# Optional, used only for country/ASN enrichment.
IPINFO_LITE_TOKEN=
